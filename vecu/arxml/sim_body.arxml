<?xml version='1.0' encoding='ASCII'?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_4-1-0.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Cluster</SHORT-NAME>
      <ELEMENTS>
        <CAN-CLUSTER>
          <SHORT-NAME>CAN</SHORT-NAME>
          <CAN-CLUSTER-VARIANTS>
            <CAN-CLUSTER-CONDITIONAL>
              <PHYSICAL-CHANNELS>
                <CAN-PHYSICAL-CHANNEL>
                  <SHORT-NAME>CAN</SHORT-NAME>
                  <FRAME-TRIGGERINGS>
                    <CAN-FRAME-TRIGGERING>
                      <SHORT-NAME>ESP_Status</SHORT-NAME>
                      <FRAME-PORT-REFS>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/ECU/GW/CN_GW/ESP_Status</FRAME-PORT-REF>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/ECU/BCM/CN_BCM/ESP_Status</FRAME-PORT-REF>
                      </FRAME-PORT-REFS>
                      <FRAME-REF DEST="CAN-FRAME">/CanFrame/FRAME_ESP_Status</FRAME-REF>
                      <PDU-TRIGGERINGS>
                        <PDU-TRIGGERING-REF-CONDITIONAL>
                          <PDU-TRIGGERING-REF DEST="PDU-TRIGGERING">/Cluster/CAN/IPDUTRIGG_ESP_Status</PDU-TRIGGERING-REF>
                        </PDU-TRIGGERING-REF-CONDITIONAL>
                      </PDU-TRIGGERINGS>
                      <CAN-ADDRESSING-MODE>STANDARD</CAN-ADDRESSING-MODE>
                      <IDENTIFIER>288</IDENTIFIER>
                    </CAN-FRAME-TRIGGERING>
                    <CAN-FRAME-TRIGGERING>
                      <SHORT-NAME>BCM_Request</SHORT-NAME>
                      <FRAME-PORT-REFS>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/ECU/GW/CN_GW/BCM_Request</FRAME-PORT-REF>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/ECU/BCM/CN_BCM/BCM_Request</FRAME-PORT-REF>
                      </FRAME-PORT-REFS>
                      <FRAME-REF DEST="CAN-FRAME">/CanFrame/FRAME_BCM_Request</FRAME-REF>
                      <PDU-TRIGGERINGS>
                        <PDU-TRIGGERING-REF-CONDITIONAL>
                          <PDU-TRIGGERING-REF DEST="PDU-TRIGGERING">/Cluster/CAN/IPDUTRIGG_BCM_Request</PDU-TRIGGERING-REF>
                        </PDU-TRIGGERING-REF-CONDITIONAL>
                      </PDU-TRIGGERINGS>
                      <CAN-ADDRESSING-MODE>STANDARD</CAN-ADDRESSING-MODE>
                      <IDENTIFIER>528</IDENTIFIER>
                    </CAN-FRAME-TRIGGERING>
                    <CAN-FRAME-TRIGGERING>
                      <SHORT-NAME>BCM_LampStatus</SHORT-NAME>
                      <FRAME-PORT-REFS>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/ECU/BCM/CN_BCM/BCM_LampStatus</FRAME-PORT-REF>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/ECU/GW/CN_GW/BCM_LampStatus</FRAME-PORT-REF>
                      </FRAME-PORT-REFS>
                      <FRAME-REF DEST="CAN-FRAME">/CanFrame/FRAME_BCM_LampStatus</FRAME-REF>
                      <PDU-TRIGGERINGS>
                        <PDU-TRIGGERING-REF-CONDITIONAL>
                          <PDU-TRIGGERING-REF DEST="PDU-TRIGGERING">/Cluster/CAN/IPDUTRIGG_BCM_LampStatus</PDU-TRIGGERING-REF>
                        </PDU-TRIGGERING-REF-CONDITIONAL>
                      </PDU-TRIGGERINGS>
                      <CAN-ADDRESSING-MODE>STANDARD</CAN-ADDRESSING-MODE>
                      <IDENTIFIER>672</IDENTIFIER>
                    </CAN-FRAME-TRIGGERING>
                    <CAN-FRAME-TRIGGERING>
                      <SHORT-NAME>BCM_DoorStatus</SHORT-NAME>
                      <FRAME-PORT-REFS>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/ECU/BCM/CN_BCM/BCM_DoorStatus</FRAME-PORT-REF>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/ECU/GW/CN_GW/BCM_DoorStatus</FRAME-PORT-REF>
                      </FRAME-PORT-REFS>
                      <FRAME-REF DEST="CAN-FRAME">/CanFrame/FRAME_BCM_DoorStatus</FRAME-REF>
                      <PDU-TRIGGERINGS>
                        <PDU-TRIGGERING-REF-CONDITIONAL>
                          <PDU-TRIGGERING-REF DEST="PDU-TRIGGERING">/Cluster/CAN/IPDUTRIGG_BCM_DoorStatus</PDU-TRIGGERING-REF>
                        </PDU-TRIGGERING-REF-CONDITIONAL>
                      </PDU-TRIGGERINGS>
                      <CAN-ADDRESSING-MODE>STANDARD</CAN-ADDRESSING-MODE>
                      <IDENTIFIER>673</IDENTIFIER>
                    </CAN-FRAME-TRIGGERING>
                  </FRAME-TRIGGERINGS>
                  <I-SIGNAL-TRIGGERINGS>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>ESP_VehicleSpeed</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/BCM/CN_BCM/ESP_VehicleSpeed</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/ESP_VehicleSpeed</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>ESP_BrakePedalPos</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/BCM/CN_BCM/ESP_BrakePedalPos</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/ESP_BrakePedalPos</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>BCM_RequestCounter</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/BCM/CN_BCM/BCM_RequestCounter</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/BCM_RequestCounter</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>BCM_LowBeamCmd</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/BCM/CN_BCM/BCM_LowBeamCmd</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/BCM_LowBeamCmd</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>BCM_HighBeamCmd</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/BCM/CN_BCM/BCM_HighBeamCmd</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/BCM_HighBeamCmd</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>BCM_TurnLeftCmd</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/BCM/CN_BCM/BCM_TurnLeftCmd</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/BCM_TurnLeftCmd</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>BCM_TurnRightCmd</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/BCM/CN_BCM/BCM_TurnRightCmd</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/BCM_TurnRightCmd</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>BCM_HazardCmd</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/BCM/CN_BCM/BCM_HazardCmd</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/BCM_HazardCmd</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>BCM_DoorFLCmd</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/BCM/CN_BCM/BCM_DoorFLCmd</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/BCM_DoorFLCmd</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>BCM_DoorFRCmd</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/BCM/CN_BCM/BCM_DoorFRCmd</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/BCM_DoorFRCmd</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>BCM_DoorRLCmd</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/BCM/CN_BCM/BCM_DoorRLCmd</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/BCM_DoorRLCmd</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>BCM_DoorRRCmd</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/BCM/CN_BCM/BCM_DoorRRCmd</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/BCM_DoorRRCmd</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>BCM_TrunkCmd</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/BCM/CN_BCM/BCM_TrunkCmd</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/BCM_TrunkCmd</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>BCM_LowBeamStatus</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/GW/CN_GW/BCM_LowBeamStatus</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/BCM_LowBeamStatus</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>BCM_HighBeamStatus</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/GW/CN_GW/BCM_HighBeamStatus</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/BCM_HighBeamStatus</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>BCM_TurnLeftStatus</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/GW/CN_GW/BCM_TurnLeftStatus</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/BCM_TurnLeftStatus</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>BCM_TurnRightStatus</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/GW/CN_GW/BCM_TurnRightStatus</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/BCM_TurnRightStatus</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>BCM_HazardStatus</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/GW/CN_GW/BCM_HazardStatus</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/BCM_HazardStatus</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>BCM_BrakeLampStatus</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/GW/CN_GW/BCM_BrakeLampStatus</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/BCM_BrakeLampStatus</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>BCM_DoorFLStatus</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/GW/CN_GW/BCM_DoorFLStatus</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/BCM_DoorFLStatus</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>BCM_DoorFRStatus</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/GW/CN_GW/BCM_DoorFRStatus</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/BCM_DoorFRStatus</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>BCM_DoorRLStatus</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/GW/CN_GW/BCM_DoorRLStatus</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/BCM_DoorRLStatus</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>BCM_DoorRRStatus</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/GW/CN_GW/BCM_DoorRRStatus</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/BCM_DoorRRStatus</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>BCM_TrunkLatchStatus</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/ECU/GW/CN_GW/BCM_TrunkLatchStatus</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/BCM_TrunkLatchStatus</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                  </I-SIGNAL-TRIGGERINGS>
                  <PDU-TRIGGERINGS>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>IPDUTRIGG_ESP_Status</SHORT-NAME>
                      <I-PDU-REF DEST="I-SIGNAL-I-PDU">/PDU/PDU_ESP_Status</I-PDU-REF>
                    </PDU-TRIGGERING>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>IPDUTRIGG_BCM_Request</SHORT-NAME>
                      <I-PDU-REF DEST="I-SIGNAL-I-PDU">/PDU/PDU_BCM_Request</I-PDU-REF>
                    </PDU-TRIGGERING>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>IPDUTRIGG_BCM_LampStatus</SHORT-NAME>
                      <I-PDU-REF DEST="I-SIGNAL-I-PDU">/PDU/PDU_BCM_LampStatus</I-PDU-REF>
                    </PDU-TRIGGERING>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>IPDUTRIGG_BCM_DoorStatus</SHORT-NAME>
                      <I-PDU-REF DEST="I-SIGNAL-I-PDU">/PDU/PDU_BCM_DoorStatus</I-PDU-REF>
                    </PDU-TRIGGERING>
                  </PDU-TRIGGERINGS>
                </CAN-PHYSICAL-CHANNEL>
              </PHYSICAL-CHANNELS>
            </CAN-CLUSTER-CONDITIONAL>
          </CAN-CLUSTER-VARIANTS>
        </CAN-CLUSTER>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>CanFrame</SHORT-NAME>
      <ELEMENTS>
        <CAN-FRAME>
          <SHORT-NAME>FRAME_ESP_Status</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Chassis state the BCM needs: put on the bus by the gateway from VSS (the browser plays the ESP).</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>ESP_Status</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/PDU/PDU_ESP_Status</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>FRAME_BCM_Request</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Event commands to the BCM. A new BCM_RequestCounter value marks a new command set; NO_REQUEST leaves a function unchanged.</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>BCM_Request</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/PDU/PDU_BCM_Request</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>FRAME_BCM_LampStatus</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Lamp outputs as driven by the BCM.</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>BCM_LampStatus</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/PDU/PDU_BCM_LampStatus</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>FRAME_BCM_DoorStatus</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Door and trunk latch state as reported by the BCM.</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>BCM_DoorStatus</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/PDU/PDU_BCM_DoorStatus</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>PDU</SHORT-NAME>
      <ELEMENTS>
        <I-SIGNAL-I-PDU>
          <SHORT-NAME>PDU_ESP_Status</SHORT-NAME>
          <LENGTH>8</LENGTH>
          <I-PDU-TIMING-SPECIFICATIONS>
            <I-PDU-TIMING>
              <TRANSMISSION-MODE-DECLARATION>
                <TRANSMISSION-MODE-TRUE-TIMING>
                  <CYCLIC-TIMING>
                    <TIME-PERIOD>
                      <VALUE>0.05</VALUE>
                    </TIME-PERIOD>
                  </CYCLIC-TIMING>
                </TRANSMISSION-MODE-TRUE-TIMING>
              </TRANSMISSION-MODE-DECLARATION>
            </I-PDU-TIMING>
          </I-PDU-TIMING-SPECIFICATIONS>
          <I-SIGNAL-TO-PDU-MAPPINGS>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>ESP_VehicleSpeed</SHORT-NAME>
              <I-SIGNAL-REF>/ISignal/ESP_VehicleSpeed</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>0</START-POSITION>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>ESP_BrakePedalPos</SHORT-NAME>
              <I-SIGNAL-REF>/ISignal/ESP_BrakePedalPos</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>16</START-POSITION>
            </I-SIGNAL-TO-I-PDU-MAPPING>
          </I-SIGNAL-TO-PDU-MAPPINGS>
        </I-SIGNAL-I-PDU>
        <I-SIGNAL-I-PDU>
          <SHORT-NAME>PDU_BCM_Request</SHORT-NAME>
          <LENGTH>8</LENGTH>
          <I-PDU-TIMING-SPECIFICATIONS>
            <I-PDU-TIMING>
              <TRANSMISSION-MODE-DECLARATION>
                <TRANSMISSION-MODE-TRUE-TIMING>
                  <CYCLIC-TIMING>
                    <TIME-PERIOD>
                      <VALUE>0.1</VALUE>
                    </TIME-PERIOD>
                  </CYCLIC-TIMING>
                </TRANSMISSION-MODE-TRUE-TIMING>
              </TRANSMISSION-MODE-DECLARATION>
            </I-PDU-TIMING>
          </I-PDU-TIMING-SPECIFICATIONS>
          <I-SIGNAL-TO-PDU-MAPPINGS>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>BCM_RequestCounter</SHORT-NAME>
              <I-SIGNAL-REF>/ISignal/BCM_RequestCounter</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>0</START-POSITION>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>BCM_LowBeamCmd</SHORT-NAME>
              <I-SIGNAL-REF>/ISignal/BCM_LowBeamCmd</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>4</START-POSITION>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>BCM_HighBeamCmd</SHORT-NAME>
              <I-SIGNAL-REF>/ISignal/BCM_HighBeamCmd</I-SIGNAL-REF>
