{
  "Vehicle.Body.Lights.Beam.High.IsOn": {
    "vss2dbc": {
      "signal": "BCM_HighBeamCmd",
      "transform": {
        "mapping": [
          {
            "from": true,
            "to": "ON"
          },
          {
            "from": false,
            "to": "OFF"
          }
        ]
      }
    },
    "dbc2vss": {
      "signal": "BCM_HighBeamStatus",
      "transform": {
        "mapping": [
          {
            "from": 1,
            "to": true
          },
          {
            "from": 0,
            "to": false
          }
        ]
      }
    }
  },
