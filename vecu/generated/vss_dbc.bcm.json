  },
  "Vehicle.Body.Lights.Brake.IsActive": {
    "dbc2vss": {
      "signal": "BCM_BrakeLampStatus",
      "transform": {
        "mapping": [
          {
            "from": "LIGHT_OFF",
            "to": "INACTIVE"
          },
          {
            "from": "LIGHT_ON",
            "to": "ACTIVE"
          },
          {
            "from": "LIGHT_FAULT",
            "to": "INACTIVE"
          },
          {
            "from": "LIGHT_SNA",
            "to": "INACTIVE"
          }
        ]
      }
    }
  },
